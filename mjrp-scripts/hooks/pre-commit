#!/bin/sh
# cópia carimbada do MJRP Harness · versão 2026-10-09 · fonte 4c7593e · não edite aqui — edite no harness e rode `new_project.py --refresh-kernel`
# pre-commit - structure by nature (EP-09) and the coherence of the requirements graph (S-67). Blocks a commit that ADDS something outside its nature
# (docs/ only memory; reports/, design/, data/ with their declared subfolders). Only what this commit
# adds is judged - an old misplacement is the doctor's W9 warning, not a blocked commit.
#
# Installed per clone by:  git config core.hooksPath mjrp-scripts/hooks   (new_project.py does it)
# Bypass is the human's call, never the agent's:  git commit --no-verify
ROOT=$(git rev-parse --show-toplevel) || exit 0
CHECK="$ROOT/mjrp-scripts/structure_check.py"
[ -f "$CHECK" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
python3 "$CHECK" "$ROOT" --staged
code=$?
if [ "$code" -eq 1 ]; then
  echo ""
  echo "  commit bloqueado: o que ele acrescenta está fora da natureza da pasta."
  echo "  cada linha acima diz para onde vai (e o git mv que sara). Regra: mjrp-scripts/structure_rules.json"
  exit 1
fi
# S-67 (2026-10-04): a status is checked against reality. A commit that touches a requirement node or a feature
# and leaves a contradiction in it (Done with no evidence, Accepted with no acceptance, Done feature with an open
# task) is refused; contradictions in nodes it does not touch are the daily pass's.
GRAPH="$ROOT/mjrp-scripts/requirements_graph_check.py"
if [ -f "$GRAPH" ]; then
  python3 "$GRAPH" "$ROOT" --staged || exit 1
fi
exit 0
