#!/bin/sh
# cópia carimbada do MJRP Harness · versão 2026-10-14 · fonte b714d244 · não edite aqui — edite no harness e rode `new_project.py --refresh-kernel`
# commit-msg - every commit brings a new entry in the project log (S-61). Born 2026-10-03/04: commits
# without a log entry, and decisions that survived a context compaction only in the AI Platform's summary.
# It runs wherever git runs, so it guards local and cloud sessions alike.
#
# Installed per clone by:  git config core.hooksPath mjrp-scripts/hooks   (new_project.py does it)
# Bypass is the human's call, never the agent's:  git commit --no-verify
ROOT=$(git rev-parse --show-toplevel) || exit 0
# 2026-10-13 (ADR-0019): the human's valves - the trailers `Conformance-waiver:` and `Catalog-editorial:` - are refused in a
# commit that also carries an agent's `Co-Authored-By:`. The agent signs what it writes, so the two cannot live together.
# First, so that it runs even where the log check is absent.
CONF="$ROOT/mjrp-scripts/conformance_check.py"
if [ -f "$CONF" ] && command -v python3 >/dev/null 2>&1; then
  python3 "$CONF" --check-msg "$1" || exit 1
fi
CHECK="$ROOT/mjrp-scripts/log_entry_check.py"
[ -f "$CHECK" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
AMEND=""
case "$(ps -o args= -p "$PPID" 2>/dev/null)" in
  *--amend*) AMEND="--amend" ;;
esac
cd "$ROOT" && python3 "$CHECK" $AMEND || exit 1
# 2026-10-09 (MJRP): a prototype that changes brings its info-arch.md and the wireframes of every screen of its
# version in the same commit. The message is read for the human's escape trailer ("Prototype-sync: skip — <why>").
SYNC="$ROOT/mjrp-scripts/prototype_sync_check.py"
[ -f "$SYNC" ] || exit 0
python3 "$SYNC" "$ROOT" --staged --msg "$1"
